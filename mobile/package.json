{
  "name": "capra",
  "private": true,
  "version": "0.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "bash scripts/ios-prebuild.sh && expo run:ios",
    "ios:sim": "bash scripts/ios-prebuild.sh && expo run:ios --device",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest",
    "eas:configure": "npx eas-cli@latest build:configure"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@herdr/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-document-picker": "^57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },

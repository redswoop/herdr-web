# systemd user unit: ~/.config/systemd/user/herdr-web.service
#   systemctl --user daemon-reload && systemctl --user enable --now herdr-web
# Replaces ttyd-herdr on :7682 once trusted.
[Unit]
Description=herdr-web — phone UI over herdr agent sessions
After=herdr.service
Wants=herdr.service

[Service]
ExecStart=/usr/bin/node %h/src/herdr-web/server.js --port 7683
Restart=on-failure
RestartSec=3
# Optional cookie auth: uncomment and set a long random token.
# Environment=HERDR_WEB_TOKEN=change-me

[Install]
WantedBy=default.target
